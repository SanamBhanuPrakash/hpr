server {
    server_name shadesofgreens.in;

    root /var/www/shadesofgreens;
    index index.html;

    location / {
        try_files $uri $uri/ /index.html;
    }

    location /api/ {
        proxy_pass http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /staging/ {
        alias /var/www/shadesofgreens/staging/;
        try_files $uri $uri/ /staging/index.html;
        add_header X-Robots-Tag "noindex, nofollow" always;
    }

    location /staging-api/ {
        rewrite ^/staging-api/(.*)$ /$1 break;
        proxy_pass http://127.0.0.1:5002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /google-ads/webhook {
        limit_except POST { deny all; }
        client_max_body_size 64k;
        proxy_read_timeout 15s;
        add_header X-Robots-Tag "noindex" always;
        proxy_pass http://127.0.0.1:5003;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/shadesofgreens.in/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/shadesofgreens.in/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot


}

server {
    server_name www.shadesofgreens.in;
    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/shadesofgreens.in/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/shadesofgreens.in/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;

    return 301 https://shadesofgreens.in$request_uri;
}

server {
    if ($host = www.shadesofgreens.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    if ($host = shadesofgreens.in) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name shadesofgreens.in www.shadesofgreens.in;
    return 404; # managed by Certbot




}
